{
  "version": 3,
  "pages404": true,
  "appType": "pages",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/api/detect",
      "regex": "^/api/detect(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/detect(?:/)?$"
    },
    {
      "page": "/api/impact",
      "regex": "^/api/impact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/impact(?:/)?$"
    },
    {
      "page": "/api/match",
      "regex": "^/api/match(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/match(?:/)?$"
    },
    {
      "page": "/api/negotiate",
      "regex": "^/api/negotiate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/negotiate(?:/)?$"
    },
    {
      "page": "/api/news/latest",
      "regex": "^/api/news/latest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/news/latest(?:/)?$"
    },
    {
      "page": "/api/sap/recovery-plan",
      "regex": "^/api/sap/recovery\\-plan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/sap/recovery\\-plan(?:/)?$"
    },
    {
      "page": "/api/sap/status",
      "regex": "^/api/sap/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/sap/status(?:/)?$"
    },
    {
      "page": "/disruptions",
      "regex": "^/disruptions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/disruptions(?:/)?$"
    },
    {
      "page": "/network",
      "regex": "^/network(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/network(?:/)?$"
    },
    {
      "page": "/plans",
      "regex": "^/plans(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/plans(?:/)?$"
    },
    {
      "page": "/risk",
      "regex": "^/risk(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/risk(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}