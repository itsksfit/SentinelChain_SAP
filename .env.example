# ==============================================================================
# SentinelChain - Environment Template
# ==============================================================================

# AI & LLM Entity Extraction Engine (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here

# Mainstream Media Baseline (NewsAPI - Optional)
NEWS_API_KEY=

# Electronics Spot Market Sourcing (Mouser API - Optional)
MOUSER_API_KEY=your_mouser_api_key_here

# SAP S/4HANA Cloud Credentials (BOM Explosion)
SAP_S4_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
SAP_S4_CLIENT_ID=
SAP_S4_CLIENT_SECRET=

# SAP Ariba Credentials & Realm (Purchase Requisition & Sourcing)
SAP_ARIBA_BASE_URL=https://openapi.ariba.com
SAP_ARIBA_REALM=
SAP_ARIBA_CLIENT_ID=
SAP_ARIBA_CLIENT_SECRET=

# SAP Business Accelerator Hub Sandbox Key
SAP_SANDBOX_API_KEY=your_sap_sandbox_api_key_here

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
